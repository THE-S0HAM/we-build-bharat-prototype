# CommunityOps Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.

# AWS
AWS_REGION=ap-south-1
AWS_PROFILE=default

# Stage
STAGE=dev

# Cognito (populated after deployment)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API (populated after deployment)
API_URL=

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-east-1

# Feature flags
ENABLE_AGENT_WORKFLOWS=true
ENABLE_RAG=false
